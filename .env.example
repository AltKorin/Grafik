# Copy to .env. Generate both secrets before exposing the app:
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_DB=grafik
POSTGRES_USER=grafik
POSTGRES_PASSWORD=replace-with-a-long-random-password
DEBUG=0
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
# Extra hosts beyond localhost/127.0.0.1/api (comma-separated), e.g. grafik.example.pl
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SECURE_COOKIES=0
# Behind nginx/Cloudflare Tunnel set SSL_REDIRECT=1 (SECURE_PROXY_SSL_HEADER is always on).
SSL_REDIRECT=0
# Exact CIDR of an upstream tunnel/proxy; forwarded headers are trusted only from it.
TRUSTED_PROXY_CIDRS=127.0.0.1/32
# Hostnames served behind a TLS-terminating tunnel; space-separated.
PUBLIC_HOSTS=localhost.invalid

# Local demo only: password of the seeded "dyrektor-demo" account (seed_demo).
DEMO_PASSWORD=
