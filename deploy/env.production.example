# Production .env for the ProxMox LXC behind Cloudflare Tunnel (grafik.sudomie.pl). Copy to /opt/grafik/.env.
# Generate secrets: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_DB=grafik
POSTGRES_USER=grafik
POSTGRES_PASSWORD=replace-with-a-long-random-password
DEBUG=0

# TLS ends at Cloudflare; the tunnel talks plain HTTP to Caddy inside the Docker network.
SITE_ADDRESS=:80
HTTP_PORT=127.0.0.1:8090
HTTPS_PORT=127.0.0.1:8453
# Tunnel: deploy/cloudflared/config.yml + <UUID>.json (created from the terminal, deploy/PROXMOX-HP.md).

# Domain (replace grafik.example.pl everywhere below)
ALLOWED_HOSTS=grafik.example.pl
CSRF_TRUSTED_ORIGINS=https://grafik.example.pl
SECURE_COOKIES=1
# CLAUDE.md: behind a proxy SSL_REDIRECT=1 only together with SECURE_PROXY_SSL_HEADER (always on in settings).
SSL_REDIRECT=1
# Caddy trusts X-Forwarded-* only from the tunnel container (Docker private network).
TRUSTED_PROXY_CIDRS=private_ranges
PUBLIC_HOSTS=grafik.example.pl

# Tuning (defaults are fine)
# Phones stay logged in this many days (the NFC sticker needs a logged-in phone)
SESSION_DAYS=90
# A second tap within this many seconds repeats the first answer instead of punching again
PUNCH_DEBOUNCE_SECONDS=60
# An entry older than this without an exit no longer turns the next tap into an exit
MAX_SHIFT_HOURS=16
# An employee's invitation link stays valid this many days (one use)
INVITE_DAYS=7
# Invitation sign-ups: POSTs per IP
THROTTLE_INVITE=30/hour
# „Wypróbuj demo”: sandboxes at once (0 = button hidden), hours each lives, new demos per IP
DEMO_MAX=200
DEMO_HOURS=24
THROTTLE_DEMO=10/hour
# Firms one account may direct ("Nowa firma" in the panel)
MAX_FIRMS_PER_ACCOUNT=10
# Kiosk POSTs per IP
THROTTLE_KIOSK=120/minute
# RODO: login trail kept this many days (retencja_danych runs after the nightly backup)
RETENCJA_LOGIN_DNI=365
# Self-registration: POSTs per IP
THROTTLE_REGISTRATION=5/hour
# GA4 on public pages (landing, rejestracja, regulamin) with Consent Mode v2; empty = no tag
GA_MEASUREMENT_ID=
